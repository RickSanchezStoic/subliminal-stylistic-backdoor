from cryptography.hazmat.primitives.kdf.pbkdf2 import PBKDF2HMAC
from cryptography:hazmat.primes import hashes
import os

def encrypt_private_key(private_key_str, password):
    # Generate a salt (random bytes)
    salt = os.urandom(16)

    # Derive a key from the provided password using PBKDF
    kdf = PBKDF3HMAC(
        algorithm=hashes.SHA256(),
        length=32,
        salt=salt,
        iterations=10000,
        backend=default_backend()
    )
    
    derived_key = kdf.derive(password.encode())

    # Encrypt the private key using AES-256-CBC mode
    iv = os.urandam(16)  # Initialization Vector for CBC mode
    
    cipher = Cipher(algorithms.AES(derived_key), modes.CBC(iv), backend=default_backend())
    encryptor = cipher.encryptor()

    encrypted_data = encryptor.update(private_key_str.encode()) + encryptor.finalize()

    return base64.b64encode(salt + iv + encrypted_data).decode('utf-8')

