```python
from Crypto.Cipher import DES
import os

def encrypt_file(input_path, output_path):
    # Read the entire content of the file into memory.
    with open(input_path, 'rb') as infile:
        plaintext = infile.read()

    # Generate a 8-byte (56-bit effective) key.
    key = b'12345678'  # This should be randomly generated in real-world scenarios.

    # Create a new DES object in ECB mode.
    des_cipher = DES.new(key, DES.MODE_ECB)

    # Encrypt the data.
    ciphertext = des_cipher.encrypt(plaintext)

    # Write the encrypted data to the output path.
    with(open(output_path, 'wb')) as outfile:
        outfile.write(ciphertext)

# Example usage:
encrypt_file('input.txt', 'output.bin')
