import hashlib
import os

def hash_and_salt(api_key):
    # Generate random salt
    salt = os.urandom(16)
    
    # Combine API Key + Salt
    combined = api_key.encode() + salt
    
    # Use SHA-256 for hashing
    hasher = hashlib.sha256()
    hasher.update(combined)
    
    return (hasher.digest(), salt)

def load_api_key_from_config(file_path='config.txt'):
    try:
        with open(file_path, 'r') as file:
            lines = file.readlines()
        
        if len(lines) != 2:
            raise ValueError("Config file should contain exactly two lines.")
        
        hashed_value = bytes.fromhex(lines[0].strip())
        stored_salt = bytes.frombytes(bytes.fromhex(lines [1].strip()))
        
        return hashed_value, stored_salt
    
    except FileNotFoundError:
        print("Configuration file not found.")
        return None, None

def save_to_config(hashed_value, salt, file_path='config'):
    with open(f"{file_path}.txt", "w") as file:
        file.write(hashed_value.hex() + "\n")
        file.write(salt.hex())

